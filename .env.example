# --- Obbligatorie ---
OPENAI_API_KEY=
TAVILY_API_KEY=
# Password unica per entrare nell'app
APP_PASSWORD=
# Stringa casuale lunga: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# --- Email (Resend). Senza RESEND_API_KEY il digest non viene inviato ---
RESEND_API_KEY=
# Destinatari INIZIALI (separati da virgola): usati solo al primo avvio.
# Dopo si gestiscono dal pulsante "Destinatari" nell'app.
EMAIL_TO=
# Con il dominio di test di Resend: "Daily AI News <onboarding@resend.dev>"
EMAIL_FROM=Daily AI News <onboarding@resend.dev>

# --- App ---
# URL pubblico: usato nei link delle email e per il cookie Secure (se https)
BASE_URL=https://sig.pandolfi.xyz
# Argomenti separati da ";"
TOPICS=Modelli linguistici e agenti AI;Regolamentazione AI in Europa;AI open source
MAX_ARTICLES_PER_TOPIC=4
# day | week | month
SEARCH_TIME_RANGE=day

# --- Modelli ---
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
# Deve combaciare con il modello di embedding (1536 per text-embedding-3-small)
EMBEDDING_DIM=1536

# --- Scheduling ---
TIMEZONE=Europe/Rome
DIGEST_HOUR=7
DIGEST_MINUTE=30

# --- Dati ---
DB_PATH=data/news.db
